4.2440</td><td>4.4738</td><td>5.1801</td><td>5.8797</td><td>6.5760</td></tr><tr><td>3.7</td><td>1.5729</td><td>2.7773</td><td>3.5443</td><td>4.2716</td><td>4.5013</td><td>5.2075</td><td>5.9071</td><td>6.6035</td></tr><tr><td>3.8</td><td>1.6025</td><td>2.8048</td><td>3.5713</td><td>4.2984</td><td>4.5281</td><td>5.2343</td><td>5.9338</td><td>6.6302</td></tr><tr><td>3.9</td><td>1.6312</td><td>2.8316</td><td>3.5977</td><td>4.3246</td><td>4.5543</td><td>5.2603</td><td>5.9598</td><td>6.6561</td></tr><tr><td>4.0</td><td>1.6592</td><td>2.8577</td><td>3.6233</td><td>4.3500</td><td>4.5797</td><td>5.2857</td><td>5.9852</td><td>6.6815</td></tr><tr><td>4.2</td><td>1.7128</td><td>2.9079</td><td>3.6728</td><td>4.3991</td><td>4.6287</td><td>5.3346</td><td>6.0340</td><td>6.7303</td></tr><tr><td>4.4</td><td>1.7636</td><td>2.9556</td><td>3.7199</td><td>4.4459</td><td>4.6755</td><td>5.3812</td><td>6.0806</td><td>6.7768</td></tr><tr><td>4.6</td><td>1.8120</td><td>3.0012</td><td>3.7649</td><td>4.4907</td><td>4.7201</td><td>5.4258</td><td>6.1251</td><td>6.8213</td></tr><tr><td>4.8</td><td>1.8582</td><td>3.0448</td><td>3.8079</td><td>4.5334</td><td>4.7629</td><td>5.4684</td><td>6.1677</td><td>6.8639</td></tr><tr><td>5.0</td><td>1.9023</td><td>3.0866</td><td>3.8492</td><td>4.5745</td><td>4.8039</td><td>5.5094</td><td>6.2086</td><td>6.9047</td></tr></table>",
